    <!-- AboutScreen.kt -->
    <string name="about_feature_write_title">Viết tay tự nhiên</string>
    <string name="about_feature_write_desc">Bút, cọ, dạ quang với độ nhạy lực nhấn, tẩy và công cụ lasso chọn/di chuyển.</string>
    <string name="about_feature_ruler_title">Thước &amp; Compa ảo</string>
    <string name="about_feature_ruler_desc">Vẽ đường thẳng, hình tròn chuẩn xác dù tay không chạm đều.</string>
    <string name="about_feature_sync_title">Đồng bộ Google Drive</string>
    <string name="about_feature_sync_desc">Dữ liệu lưu trên Drive của chính bạn, không qua máy chủ trung gian.</string>
    <string name="about_feature_share_title">Chia sẻ link xem-only</string>
    <string name="about_feature_share_desc">Gửi ghi chú cho bạn bè/giáo viên chỉ bằng một đường link.</string>
    <string name="about_feature_ocr_title">Nhận dạng chữ viết tay</string>
    <string name="about_feature_ocr_desc">Chuyển nét vẽ tay thành văn bản ngay trên máy, không cần mạng.</string>
    <string name="about_feature_import_title">Chèn ảnh/PDF làm nền</string>
    <string name="about_feature_import_desc">Annotate trực tiếp lên giáo trình hoặc tài liệu PDF/ảnh.</string>
    <string name="about_version">Phiên bản %1$s</string>
    <string name="about_description">KapiNotes là ứng dụng ghi chú viết tay dành cho Android, tối ưu cho máy tính bảng có bút cảm ứng (stylus). Hỗ trợ nhiều loại giấy, chèn ảnh/PDF làm nền để chú thích, đồng bộ và sao lưu qua Google Drive của chính bạn.</string>
    <string name="about_highlights_heading">Tính năng nổi bật</string>
    <string name="about_footer">© 2026 KapiNotes. Dữ liệu ghi chú luôn thuộc về Google Drive của bạn - không có máy chủ trung gian nào khác.</string>
    <string name="action_retry">Thử lại</string>

